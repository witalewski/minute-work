{
  "name": "EmomTimer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:styles": "node ./scripts/generate-uniwind.cjs",
    "prestart": "npm run generate:styles",
    "start": "rock start",
    "preweb": "npm run generate:styles",
    "web": "rspack serve --config rspack.web.config.mjs --mode development",
    "prebuild:web": "npm run generate:styles",
    "build:web": "rspack build --config rspack.web.config.mjs --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --no-watchman",
    "preandroid": "npm run generate:styles",
    "android": "rock run:android",
    "preios": "npm run generate:styles",
    "ios": "rock run:ios"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "tailwindcss": "4.3.3",
    "uniwind": "1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@callstack/repack": "^5.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@rock-js/platform-android": "0.15.1",
    "@rock-js/platform-ios": "^0.15.1",
    "@rock-js/plugin-repack": "^0.15.1",
    "@rock-js/welcome-screen": "^0.15.1",
    "@rspack/cli": "^1.5.0",
    "@rspack/core": "^1.5.0",
    "@swc/helpers": "^0.5.17",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-transform-worker": "0.84.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "rock": "^0.15.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
